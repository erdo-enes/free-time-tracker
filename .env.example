# FreeTime Jira - Environment Variables
# Copy this file to .env and fill in your values

# Steam (monitoring account) - get key from https://steamcommunity.com/dev/apikey
FREETIME_STEAM_API_KEY=
FREETIME_STEAM_STEAMID=

# PSN (monitoring account) - get NPSSO cookie from https://my.playstation.com
FREETIME_PSN_NPSSO_TOKEN=

# Xbox (monitoring account) - get key from https://xbl.io
FREETIME_XBOX_OPENXBL_KEY=

# Nintendo Switch 2 (monitoring account) - get NSO token
FREETIME_SWITCH2_NSO_TOKEN=

# Tracker poll interval in seconds (default: 300 = 5 minutes)
FREETIME_TRACKER_POLL_INTERVAL_SECONDS=300
